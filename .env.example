# Copier en .env.local (ignoré par git) puis redémarrer `npx expo start`.
# Seule variable publique de l'application : l'adresse de l'API Django, terminée par /api.
# Téléphone sur le même Wi-Fi que le PC : IP du PC (ipconfig), avec `runserver 0.0.0.0:8000` côté backend.
# Émulateur Android : http://10.0.2.2:8000/api
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api
